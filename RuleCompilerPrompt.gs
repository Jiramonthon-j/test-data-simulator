/**
 * ============================================================================
 * Rule Compiler Prompt — โค้ดสำรอง (ไม่มีจุดไหนใน Code.gs เรียกใช้แล้วจริงๆ ตั้งแต่ 2026-09-19)
 * ----------------------------------------------------------------------------
 * (แก้ไข 2026-09-19) ไฟล์นี้เคย "เชื่อมเข้าระบบจริง" อยู่ช่วงหนึ่ง — handleGenerate_ ใน Code.gs เคยเรียก
 * buildRuleCompilerPrompt_() (ผ่าน compileRules_() ใน RuleDispatcher.gs) เป็น "Phase 1" ของ Rule-Based Mode จริงๆ
 * แต่ผู้ใช้ต้องการให้ Rule-Based Mode เป็นโค้ดล้วน 100% ไม่มี AI ผสมแม้แต่จุดเดียว — จึงเปลี่ยน Phase 1 มาเป็น
 * getRuleTemplateForColumns_() (นิยามใน RuleDispatcher.gs แทน) ที่อ่านกฎจากชีต RuleTemplates ที่มนุษย์เขียนไว้เอง
 * โดยตรง ไม่เรียก Gemini เลย — ไฟล์นี้ (และ compileRules_()) จึงเหลือไว้เป็นโค้ดสำรอง เผื่ออนาคตต้องการโหมด
 * AI-assisted อีกแบบกลับมาใช้ ยังไม่ได้ลบทิ้งเพราะไม่กระทบอะไรถ้าไม่ถูกเรียก แต่ปัจจุบัน "ไม่ได้ทำงานอยู่จริง"
 *
 * แนวคิดเดิม: แยกงาน "เข้าใจภาษา" (Gemini ทำครั้งเดียว) ออกจากงาน "สุ่มค่า" (โค้ดทำเอง ไม่ใช้ Gemini)
 * ผลลัพธ์ที่ Gemini ต้องตอบกลับมาไม่ใช่ "ข้อมูลตัวอย่าง" แต่เป็น "กฎ" (JSON) ที่ฟังก์ชัน GENERATORS_
 * ใน dispatcher (RuleDispatcher.gs) จะนำไป switch-case สุ่มค่าเองต่อทุกแถว — ทำให้เรียก Gemini แค่ 1 ครั้ง
 * ต่อ 1 คำขอ (ไม่ว่าจะขอกี่พันแถว) แทนที่จะให้ Gemini เขียนข้อมูลทุกแถวเองแบบที่ buildSmartPrompt_ ทำอยู่ตอนนี้
 *
 * หลักการออกแบบ prompt นี้ (เพื่อ "กระชับ + ละเอียด + ประหยัด token + ผลลัพธ์ฉลาด"):
 *   1. เมนู generator เขียนเป็นบรรทัดเดียวแบบย่อ (shorthand) ไม่ยกตัวอย่างเต็มรูปแบบซ้ำหลายรอบ
 *      -> ประหยัด token แต่ Gemini รุ่นปัจจุบันเข้าใจ shorthand เชิง syntax แบบนี้ได้ดีอยู่แล้ว
 *   2. บังคับ "เมนูปิด" (closed vocabulary) ชัดเจนตั้งแต่ต้น กัน Gemini เดา/สร้างชื่อ generator ใหม่เอง
 *      -> ทำให้ dispatcher ฝั่งโค้ด switch-case แบบ dictionary lookup ตรงๆ ได้โดยไม่ต้องเผื่อเคสแปลก
 *   3. มี "ทางออก" (ai_context) เสมอสำหรับเงื่อนไขที่ซับซ้อนเกินเมนู — กันไม่ให้ Gemini ฝืนเลือก generator
 *      ที่ไม่ตรงจริง (ซึ่งจะทำให้ข้อมูลที่สุ่มออกมาผิดเงื่อนไขแบบเงียบๆ โดยที่ระบบไม่รู้ตัว)
 *   4. ย้ำกฎ DDL/ชื่อคอลัมน์ท้าย prompt อีกครั้ง — อิงพฤติกรรมที่พิสูจน์แล้วจาก buildSmartPrompt_ (ดูคอมเมนต์
 *      บรรทัด 2950-2952 ใน Code.gs) ว่า Gemini ให้น้ำหนักกับคำสั่งท้าย prompt สูงกว่าคำสั่งต้น prompt
 *   5. ใช้ getTodayContextStr_() เดิมของระบบ (ไม่สร้างใหม่) เพื่อให้ date_range คำนวณวันที่สัมพัทธ์ถูกต้อง
 *      สอดคล้องกับ buildSmartPrompt_ ที่ใช้ตัวเดียวกันอยู่แล้ว
 *   6. สั่งตอบ JSON แบบ compact (ไม่เว้นบรรทัด) เหมือน buildSmartPrompt_ — ยิ่งมีผลชัดเจนขึ้นในเฟสนี้เพราะ
 *      output คือ "กฎ" ไม่ใช่ "ข้อมูล" จึงสั้นกว่าเดิมมาก (ไม่ต้องส่ง rows เป็นร้อยเป็นพันชุดอีกต่อไป)
 *
 * Input ที่ต้องมี: p.promptAddition (เงื่อนไขอิสระที่ผู้ใช้พิมพ์), p.ddlScript (โครงสร้างตาราง)
 * Output ที่คาดหวังจาก Gemini: {"columns":[{"name":"...","generator":"...", ...params...}]}
 * ============================================================================
 */

// เมนู generator แบบปิด — โค้ด dispatcher (GENERATORS dictionary) ต้องมีฟังก์ชันรองรับครบทุกชื่อในนี้เป๊ะ
// เพิ่ม generator ใหม่ทีหลังได้ แต่ต้องเพิ่มทั้ง 2 ฝั่งพร้อมกันเสมอ (ที่นี่ + ที่ dispatcher) ไม่งั้น Gemini จะเลือกชื่อที่โค้ดไม่รู้จัก
const RULE_GENERATOR_MENU_ =
  'pattern(pattern) "#"=เลข 1 หลัก "@"=ตัวอักษร 1 ตัว เช่น "POL-########" | ' +
  'enum(values:[...]) เลือก 1 ค่าแบบสุ่มจากลิสต์ที่กำหนด ใช้ข้อความในเครื่องหมายคำพูดของเงื่อนไขตรงตัวเป๊ะ | ' +
  'number_range(min,max,decimals) สุ่มเลขในช่วง | ' +
  'date_range(start,end) รูปแบบ YYYY-MM-DD คำนวณจากวันนี้ถ้าโจทย์พูดแบบสัมพัทธ์ | ' +
  'percent_of(baseColumn,percentMin,percentMax) ค่า = % ของคอลัมน์อื่นในแถวเดียวกัน | ' +
  'thai_citizen_id() เลข 13 หลักที่ผ่าน checksum จริง | ' +
  'phone_th() เบอร์มือถือไทย 10 หลัก | ' +
  'email_from_name(nameColumn) สร้างอีเมลจากคอลัมน์ชื่อในแถวเดียวกัน | ' +
  'sequential(prefix,start,digits) เลขรันต่อเนื่อง ถ้าตัวอย่างเริ่มต้นมีเลขศูนย์นำหน้า (เช่น "EMP-2026-001") ต้องตั้ง digits=ความยาวหลักตัวเลขนั้น (=3) เสมอ เพื่อให้ทุกแถวคงเลขศูนย์นำหน้าไว้ ไม่ใช่แค่ "EMP-2026-1"';

// ---------------------------------------------------------------------------
// INSURANCE DOMAIN HINT — inject อัตโนมัติเฉพาะตอนคำขอดูเข้าข่ายสายงานประกันภัยเท่านั้น
// คำขอทั่วไปที่ไม่เกี่ยวกับประกันเลยจะไม่โดนเพิ่ม token ส่วนนี้แม้แต่นิดเดียว (เช็คแล้วไม่เข้าเงื่อนไข -> ข้าม)
// ใช้คลังข้อมูลจาก INSURANCE_REFDATA (ต้องมีไฟล์ InsuranceReferenceData.gs อยู่ในโปรเจกต์เดียวกันด้วย)
// เป้าหมาย: ให้ Gemini อ้างอิงชื่อบริษัท/สถานะ/ประเภทกรมธรรม์ที่ "มีอยู่จริง" แทนการเดา/สะกดชื่อเอาเอง
// ถ้ายังไม่ได้วางไฟล์ InsuranceReferenceData.gs ไว้ในโปรเจกต์ ฟังก์ชันนี้จะ throw — จึงครอบด้วย try/catch
// ตรงจุดเรียกใช้เสมอ กัน Rule Compiler ทั้งระบบล่มเพราะไฟล์เสริมไฟล์เดียวหายไป
// ---------------------------------------------------------------------------
const INSURANCE_CONTEXT_KEYWORDS_ = [
  'ประกัน', 'กรมธรรม์', 'เบี้ยประกัน', 'เคลม', 'สินไหม', 'ผู้เอาประกัน', 'ผู้รับผลประโยชน์',
  'ตัวแทนประกัน', 'นายหน้าประกัน', 'insurance', 'policy', 'premium', 'claim', 'underwrit', 'beneficiary', 'insurer'
];

function isInsuranceContext_(p) {
  const haystack = [p.dataType, p.tableName, p.promptAddition, p.ddlScript]
    .filter(Boolean).join(' ').toLowerCase();
  return INSURANCE_CONTEXT_KEYWORDS_.some(function (kw) { return haystack.indexOf(kw.toLowerCase()) !== -1; });
}

// เอาเฉพาะหมวดที่เป็น array ตรงๆ (ข้าม PATTERN_EXAMPLES ที่เป็น object ย่อย ไว้ใช้แบบ manual เท่านั้น ไม่ใส่ใน prompt)
function buildInsuranceReferenceHint_() {
  const lines = ['ข้อมูลอ้างอิงสายงานประกันภัยไทยที่มีอยู่จริง (ใช้ค่าจากรายการนี้แทนการเดาเองทุกครั้งที่เงื่อนไขต้องการ enum ประเภทนี้):'];
  Object.keys(INSURANCE_REFDATA).forEach(function (key) {
    const val = INSURANCE_REFDATA[key];
    if (Array.isArray(val)) {
      lines.push('- ' + key + ': ' + val.join(', '));
    }
  });
  return lines.join('\n');
}

/**
 * สร้าง prompt สำหรับ Rule Compiler (Phase 1) — เรียก Gemini ครั้งเดียวต่อคำขอ ไม่ว่าจะสร้างกี่แถว
 * @param {Object} p            payload เดิมจากหน้าเว็บ (มี p.ddlScript, p.promptAddition, p.dialect)
 * @param {string} todayStr     ผลจาก getTodayContextStr_() เดิมของระบบ — ส่งเข้ามาแทนเรียกซ้ำในนี้
 */
function buildRuleCompilerPrompt_(p, todayStr) {
  const parts = [];

  parts.push('คุณคือ "ตัวแปลกฎ" (Rule Compiler) หน้าที่เดียวคือแปลงเงื่อนไขของแต่ละคอลัมน์ให้เป็นกฎ JSON ที่โค้ดจะนำไปสุ่มค่าเองภายหลัง ห้ามสร้างข้อมูลตัวอย่างหรือค่าจริงใดๆ ในคำตอบเด็ดขาด');

  parts.push('DDL Script (โครงสร้างตารางจริง ต้องยึดตามนี้เท่านั้น):\n' + p.ddlScript);

  parts.push('เงื่อนไขเพิ่มเติมจากผู้ใช้: ' + (p.promptAddition || '(ไม่มี ใช้ดุลพินิจจาก DDL อย่างเดียว)'));

  // (fix) เดิม compileRules_ ส่ง null แทนรูปเสมอ ทำให้รูป Schema/ER Diagram ที่แนบมาถูกเมิน แม้จะแก้ให้ส่งรูปจริง
  // เข้า callGemini_ แล้วก็ตาม (ดู RuleDispatcher.gs) แต่ถ้าไม่บอกในข้อความ prompt ตรงๆ ว่ามีรูปนี้อยู่ Gemini
  // มักจะเห็นรูปแต่ไม่รู้ว่าเกี่ยวข้องกับคำขอนี้ยังไงแล้วเมินไปเฉยๆ (พฤติกรรมที่พิสูจน์แล้วจาก buildSmartPrompt_
  // เดิม ดูคอมเมนต์บรรทัด 2957-2958 ใน Code.gs) จึงต้องย้ำในข้อความ prompt เหมือนกันด้วย ไม่พึ่งแค่ส่งรูปอย่างเดียว
  if (p.schemaImageBase64) {
    parts.push('มีรูปภาพ Schema/ER Diagram แนบมาพร้อมคำขอนี้ด้วย ให้วิเคราะห์รูปอย่างละเอียดแล้วใช้เป็นข้อมูลอ้างอิงเพิ่มเติมสำหรับ: ชื่อคอลัมน์, ชนิดข้อมูล, คีย์หลัก/คีย์นอก และความสัมพันธ์ระหว่างตาราง หากรายละเอียดในรูปขัดแย้งกับ DDL Script ด้านบน ให้ยึดตาม DDL Script เป็นหลัก แต่ยังคงต้องใช้รูปประกอบการตัดสินใจเลือก generator ที่เหมาะสมด้วย');
  }

  if (isInsuranceContext_(p)) {
    try {
      parts.push(buildInsuranceReferenceHint_());
    } catch (e) {
      // ไฟล์ InsuranceReferenceData.gs ยังไม่ได้วางไว้ในโปรเจกต์ หรือโครงสร้างข้อมูลเปลี่ยนไป — ข้ามได้ ไม่ควรทำให้ทั้งคำขอล้ม
      logActivity_('SYSTEM', 'SYSTEM', 'INSURANCE_HINT_SKIPPED', 'ข้ามการแนบข้อมูลอ้างอิงสายประกัน: ' + e.message);
    }
  }

  parts.push('วันนี้คือ ' + todayStr + ' ใช้เป็นฐานคำนวณเมื่อ generator เป็น date_range และเงื่อนไขพูดถึงเวลาสัมพัทธ์เท่านั้น ห้ามใช้ปี/วันที่จากความจำตัวเอง');

  // (fix) เดิม ai_context ตอบแค่ {"generator":"ai_context","instruction":"..."} ซึ่งเป็นแค่ "คำสั่ง" ที่ต้องเรียก Gemini
  // ซ้ำอีกรอบ (fillAiContextColumns_) หลังสุ่มคอลัมน์อื่นครบทุกแถวแล้ว เพื่อให้ Gemini เขียนเนื้อหาจริงทีเดียวทุกแถว
  // ทำให้ Hybrid ยิง Gemini 3 ครั้ง/รอบ (แปลงกฎ+เติมข้อความ+AI self-check) แพงกว่าระบบเดิม (buildSmartPrompt_) ที่ใช้
  // แค่ 2 ครั้ง/รอบ (สร้างข้อมูล+AI self-check) — พิสูจน์จากการทดสอบจริงว่ากินโควตาเร็วกว่าของเดิมมาก (2026-09-07)
  // แก้โดยให้ Gemini เขียน "แม่แบบ" เนื้อหาจริงมาเลยตั้งแต่ครั้งเดียวนี้ (ไม่ใช่แค่คำสั่ง) แล้วให้โค้ด dispatcher
  // (ดู genAiContextFromTemplate_ ใน RuleDispatcher.gs) สุ่มเลือกแม่แบบ + แทนค่าคอลัมน์จริงเองทีหลังต่อแถว
  // ไม่ต้องเรียก Gemini ซ้ำอีกเลย — ทำให้ Hybrid เหลือ 2 ครั้ง/รอบเท่าระบบเดิมพอดี (หรือน้อยกว่าถ้าไม่มีคอลัมน์แบบนี้)
  // (fix) เดิมสั่งตายตัวว่าเขียนแม่แบบ "2-4 แบบ" ไม่ว่าจะขอกี่แถวก็ตาม — พอขอแถวเยอะ (เช่น 280 แถว) แม่แบบแค่ 2-4 แบบ
  // ถูกสุ่มวนซ้ำถี่มาก (เฉลี่ยแบบละ ~70-140 แถว) ข้อมูลซ้ำเยอะเกินไปจนดูไม่สมจริง — ผู้ใช้ทักท้วงจริงหลังทดสอบ Test 4
  // (280 แถว, 2026-09-07) แก้โดยปรับจำนวนแม่แบบขั้นต่ำที่แนะนำให้ Gemini ตามจำนวนแถวที่ขอจริง (ยิ่งขอเยอะยิ่งต้องมีแม่แบบ
  // เยอะขึ้นตาม) แต่ยังอยู่ในการเรียก Gemini "ครั้งเดียว" เท่าเดิม (แค่ผลลัพธ์ยาวขึ้นเล็กน้อย ไม่ได้เพิ่มจำนวนครั้งที่เรียก)
  const rowsRequestedNum = parseInt(p.rowsRequested, 10) || 0;
  // (fix 2026-09-10) เดิมสูตรนี้ปัดจำนวนแม่แบบขั้นต่ำลงเหลือแค่ 3 เสมอเมื่อขอแถวน้อย (เช่น 5 แถว เพราะ ceil(5/30)=1 ชนพื้นล่างที่ 3)
  // พิสูจน์จากการทดสอบจริงว่า 3 แม่แบบสำหรับ 5 แถว การันตีว่าต้องมีซ้ำอย่างน้อย 1 คู่ (5 มากกว่า 3 ตาม pigeonhole principle)
  // ทำให้ AI self-check ตัดคะแนนความน่าเชื่อถือลง (customer_name ซ้ำ 3 ใน 5 แถว) — แก้โดยแยกสูตรสำหรับแถวน้อย (<=10 แถว)
  // ให้ขอแม่แบบเท่ากับจำนวนแถวที่ขอเลย (สูงสุด 10) แทนที่จะปัดลงเหลือ 3 เสมอ ส่วนแถวเยอะ (>10 แถว) ยังคงใช้สูตรเดิมที่
  // พิสูจน์แล้วว่าใช้ได้ดีกับ 280 แถว (ได้ ~10 แม่แบบ) ไม่กระทบ path นี้เลย
  const minTemplatesSuggested = rowsRequestedNum <= 10
    ? Math.max(3, Math.min(10, rowsRequestedNum))
    : Math.max(3, Math.min(10, Math.ceil(rowsRequestedNum / 30)));

  parts.push(
    'สำหรับทุกคอลัมน์ใน DDL ให้ตัดสินใจ 2 ทางนี้เท่านั้น:\n' +
    '(1) ถ้าเงื่อนไขแปลงเป็นกฎตายตัวได้ ให้เลือก generator จากเมนูปิดนี้เท่านั้น ห้ามคิดชื่อ generator ใหม่เอง: ' + RULE_GENERATOR_MENU_ + '\n' +
    '(2) ถ้าเป็นข้อความอิสระที่ต้องใช้ดุลพินิจเชิงความหมาย/บริบทธุรกิจ (เช่น รีวิว, หมายเหตุ, คำอธิบายผลงาน) ที่ generator ในเมนูไม่ครอบคลุม ' +
    'ให้ตอบ {"generator":"ai_context","templates":["...","..."]} โดยเขียนแม่แบบข้อความจริงมาให้เลย (ไม่ใช่แค่คำสั่งให้ไปเขียนทีหลัง) ' +
    'คำขอนี้ต้องการข้อมูล ' + rowsRequestedNum + ' แถว ให้เขียนแม่แบบอย่างน้อย ' + minTemplatesSuggested + ' แบบที่หลากหลายกันจริง (ใช้คำ/โครงประโยคต่างกัน ไม่ใช่แค่สลับคำ 1-2 คำ) ' +
    'ยิ่งขอแถวเยอะยิ่งต้องมีแม่แบบเยอะขึ้นตามสัดส่วน เพื่อไม่ให้ข้อความซ้ำแบบเดิมถี่เกินไปเมื่อสุ่มเลือกใช้หลายแถว ' +
    'ใช้ {{ชื่อคอลัมน์}} แทนตำแหน่งที่ต้องแทรกค่าจริงของคอลัมน์อื่นในแถวเดียวกัน (สะกดชื่อคอลัมน์ให้ตรงกับ DDL เป๊ะ) ' +
    'ถ้าเนื้อหาที่เหมาะสมต้องต่างกันชัดเจนตามค่าของคอลัมน์อื่นในแถวเดียวกัน (เช่น ต้องพูดต่างกันเมื่อสถานะจัดส่งเป็น "Delivered" กับ "Shipped") ' +
    'ให้ใช้ {"generator":"ai_context","variants":[{"when":{"<ชื่อคอลัมน์>":"<ค่าที่ต้องตรงกัน>"},"templates":["...","..."]},...],"templates":["...แม่แบบสำรองกรณีไม่ตรง variant ไหนเลย..."]} แทน ' +
    '(แต่ละกลุ่ม variant ก็ควรมีแม่แบบหลายแบบเช่นกัน ไม่ใช่กลุ่มละ 1 แบบตายตัว) ' +
    '— ห้ามฝืนเลือก generator ที่ไม่ตรงเงื่อนไขจริงเด็ดขาด'
  );

  parts.push('ถ้าคอลัมน์ไหนไม่มีเงื่อนไขระบุเจาะจงเลย ให้ใช้ ai_context โดยเขียนแม่แบบข้อความอิสระจากชื่อคอลัมน์และชนิดข้อมูลใน DDL แทน อย่าเดา generator ที่ไม่มีหลักฐานรองรับ');

  // (fix 2026-09-10) พิสูจน์จากการทดสอบจริงว่า Gemini เลือก generator ที่ปล่อยให้ค่าซ้ำกันได้ (เช่น number_range) ให้กับคอลัมน์ที่เป็น ID หลัก
  // ตอนผู้ใช้ไม่ได้ระบุเงื่อนไขอะไรเกี่ยวกับคอลัมน์นั้นเลย ผลคือ ID ซ้ำกันข้ามแถว (เช่น customer_id=10001 ปรากฏ 3 แถว) และแย่กว่านั้นคือ
  // ID เดียวกันถูกผูกกับชื่อคนละคนในแต่ละแถว (เพราะแต่ละคอลัมน์สุ่มอิสระจากกัน ไม่มีการเชื่อมโยงกัน) — AI self-check เองก็ตรวจจับได้ว่า
  // ข้อมูลแบบนี้ "ไม่น่าเชื่อถือ" (คะแนน reliability ต่ำ) ถือเป็นข้อมูลผิดพลาดที่ยอมรับไม่ได้ ไม่ใช่แค่เกณฑ์ตรวจสอบเข้มเกินไป
  // แก้โดยเพิ่มกฎบังคับแยกออกมาให้ชัดเจน คอลัมน์ที่หน้าตาเป็น ID หลักต้องการันตีไม่ซ้ำกันเสมอ ไม่ว่าจะมีเงื่อนไขอื่นระบุไว้หรือไม่ก็ตาม
  parts.push('ข้อยกเว้นสำคัญของกฎด้านบน: ถ้าคอลัมน์ดูเหมือนเป็นรหัส/ID หลักของแถว (ชื่อคอลัมน์มีคำว่า id, รหัส, เลขที่ หรือถูกประกาศเป็น PRIMARY KEY ใน DDL) ' +
    'และผู้ใช้ไม่ได้ระบุเงื่อนไขให้ซ้ำกันได้เป็นอย่างอื่นชัดเจน ให้เลือก generator เป็น sequential เสมอ (ห้ามใช้ number_range/enum/ai_context กับคอลัมน์ประเภทนี้) ' +
    'เพื่อการันตีว่าค่าจะไม่ซ้ำกันเลยในแต่ละแถวที่สร้าง เพราะ ID ที่ซ้ำกันแล้วถูกผูกกับข้อมูลอื่นในแถวไม่ตรงกัน (เช่น ID เดียวกันแต่ชื่อคนละคน) ถือเป็นข้อมูลผิดพลาดร้ายแรงที่ยอมรับไม่ได้');

  parts.push('ย้ำอีกครั้งก่อนตอบ: ต้องมี object ครบทุกคอลัมน์ที่มีใน DDL เป๊ะ ห้ามขาดห้ามเกิน ชื่อ "name" ต้องตรงชื่อคอลัมน์ใน DDL ทุกตัวอักษร ห้ามมี key อื่นนอกจาก name/generator/พารามิเตอร์ที่จำเป็นของ generator นั้นๆ');

  parts.push('ตอบกลับเป็น JSON ล้วนเท่านั้น ห้ามมีข้อความอื่นนอก JSON ห้ามใช้ markdown code block รูปแบบต้องเป็น: {"columns":[{"name":"...","generator":"...","...":"..."}]} ตอบแบบ compact ไม่เว้นบรรทัด ไม่เคาะ indent และต้องปิด JSON ให้ครบสมบูรณ์เสมอ');

  return parts.filter(Boolean).join('\n\n');
}
