/**
 * คืนรายชื่อ "หมวด" ทั้งหมดที่มีอยู่ในคลังนี้ (ใช้เวลาต้องการแสดงเมนูให้เลือกว่ามีหมวดอะไรบ้าง)
 */
function listInsuranceReferenceCategories_() {
  return Object.keys(INSURANCE_REFDATA);
}

/**
 * แปลงรายการในหมวดที่ระบุให้เป็นข้อความพร้อมวางในช่อง "เงื่อนไขเพิ่มเติม" ตรงๆ
 * เช่น formatInsuranceEnumForPrompt_('POLICY_STATUS', 'policy_status')
 * -> 'policy_status เป็นหนึ่งใน "Active", "Pending", ...'
 */
function formatInsuranceEnumForPrompt_(categoryKey, columnName) {
  const list = INSURANCE_REFDATA[categoryKey];
  if (!list || !Array.isArray(list)) {
    throw new Error('ไม่พบหมวด "' + categoryKey + '" ในคลังข้อมูล — ดูชื่อหมวดที่มีได้จาก listInsuranceReferenceCategories_()');
  }
  const quoted = list.map(function (v) { return '"' + v + '"'; }).join(', ');
  return (columnName || categoryKey) + ' เป็นหนึ่งใน ' + quoted;
}

/**
 * สร้างสรุปคลังข้อมูลทั้งหมดเป็นข้อความอ่านง่าย (ไว้ปริ๊นท์ดู หรือ log ออกมาอ่านทั้งชุด)
 * เรียกผ่านเมนู Apps Script (Run > printInsuranceReferenceSummary_) แล้วดูผลใน View > Logs ได้เลย
 */
function printInsuranceReferenceSummary_() {
  const lines = [];
  Object.keys(INSURANCE_REFDATA).forEach(function (key) {
    const val = INSURANCE_REFDATA[key];
    lines.push('== ' + key + ' ==');
    if (Array.isArray(val)) {
      lines.push(val.join(', '));
    } else {
      Object.keys(val).forEach(function (subKey) {
        lines.push(subKey + ': ' + val[subKey]);
      });
    }
    lines.push('');
  });
  const summary = lines.join('\n');
  Logger.log(summary);
  return summary;
}
